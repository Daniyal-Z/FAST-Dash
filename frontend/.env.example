# Copy to .env.local and fill in from your Supabase project settings
# (Supabase Dashboard -> Project Settings -> API)
#
# Both values are safe to expose in the browser bundle: the anon key only ever
# grants what Row Level Security allows. Writes are gated on public.is_admin().
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
